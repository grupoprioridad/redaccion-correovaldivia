RewriteEngine On

# Ocultar extensión .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirigir .php a sin extensión (SEO)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Seguridad
<FilesMatch "\.(inc|sql|md|log)$">
    Require all denied
</FilesMatch>

Options -Indexes
